{
  "name": "ai-social-content-studio",
  "productName": "AI Social Content Studio",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "start": "node scripts/electron-vite.mjs preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "package": "npm run fetch:ffmpeg && npm run build && electron-builder --win nsis",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "xyz.hasbiyallahu.aisocialcontentstudio",
    "productName": "AI Social Content Studio",
    "copyright": "Hasbiyallahu Jafaru",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend",
        "to": "backend"
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AI Social Content Studio",
      "deleteAppDataOnUninstall": false
    }
  },
  "description": "Turn a brief or a long video into finished, platform-ready short-form content. Local only.",
  "author": {
    "name": "Hasbiyallahu Jafaru",
    "url": "https://hasbiyallahu.xyz"
  },
  "homepage": "https://github.com/HasbiyallahuJafaru/aicontentstudio"
}
